# ================================================================
# TRACES — Environment Variables
# Copy this file to .env.local for local development
# NEVER commit .env.local to version control
# ================================================================

# ── Supabase ──────────────────────────────────────────────────────
# Project URL only — do NOT include /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose client-side

# Direct Postgres connection (for migrations: npm run db:migrate:phase2)
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Clerk Authentication ───────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── PostHog Analytics ─────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Moderation ────────────────────────────────────────────────────
PERSPECTIVE_API_KEY=your-google-perspective-api-key   # optional, graceful degradation

# ── Security ──────────────────────────────────────────────────────
FINGERPRINT_SALT=change-this-to-a-long-random-string-in-production
CRON_SECRET=change-this-to-another-long-random-string

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cloudflare R2 (optional, for avatar storage) ──────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=traces-uploads
# NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.traces.app
