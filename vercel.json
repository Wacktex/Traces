{
  "crons": [
    {
      "path": "/api/cron/unlock-capsules",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "regions": ["iad1"],
  "functions": {
    "app/api/cron/unlock-capsules/route.ts": { "maxDuration": 60 },
    "app/api/webhooks/clerk/route.ts":       { "maxDuration": 10 }
  }
}
